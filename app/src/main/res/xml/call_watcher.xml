<?xml version="1.0" encoding="utf-8"?>
<!-- The light call watcher: only calling apps' notification events. It can't read the screen or
     intercept keys, which many banking apps tolerate. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeNotificationStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:description="@string/call_watcher_description"
    android:notificationTimeout="100"
    android:packageNames="com.whatsapp,com.whatsapp.w4b,org.thoughtcrime.securesms,org.telegram.messenger,com.facebook.orca,com.viber.voip,com.skype.raider,com.microsoft.teams,com.google.android.apps.tachyon" />
